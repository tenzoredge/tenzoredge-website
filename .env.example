# Analytics (optional). Nothing loads until a visitor opts in via the consent banner.
# Set these in Vercel → Project → Settings → Environment Variables, then redeploy.
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=

# --- Contact form email (server-side only; never prefix these with VITE_) ---
# API key from https://resend.com (free tier). Without it, `npm run dev` prints the email
# to the terminal instead of sending it; on Vercel the form shows an error until it is set.
RESEND_API_KEY=
# Optional overrides
CONTACT_TO_EMAIL=support@tenzoredge.com
CONTACT_FROM_EMAIL=Tenzor Edge Website <website@tenzoredge.com>
